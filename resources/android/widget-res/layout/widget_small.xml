<?xml version="1.0" encoding="utf-8"?>
<!-- Small (2 x 1): title and date on the left, compact digits on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Tinted at runtime with the colours picked in the app. -->
    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/ss_sans"
            android:maxLines="1"
            android:text="@string/ss_widget_title"
            android:textColor="@color/ss_widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/ss_sans"
            android:maxLines="1"
            android:textColor="@color/ss_widget_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/ss_sans"
            android:maxLines="1"
            android:textColor="@color/ss_widget_warn"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_tm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingLeft="8dp">

        <LinearLayout
            android:id="@+id/w_seg1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_seg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingTop="4dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/w_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ss_mono"
                android:includeFontPadding="false"
                android:textColor="@color/ss_widget_accent"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/w_dayslabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ss_sans"
                android:text="@string/ss_widget_days"
                android:textColor="@color/ss_widget_muted"
                android:textSize="8sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_sep1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ss_sans"
            android:text=":"
            android:textColor="@color/ss_widget_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/w_seg2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/widget_seg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingTop="4dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/w_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ss_mono"
                android:includeFontPadding="false"
                android:textColor="@color/ss_widget_accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/w_hourslabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ss_sans"
                android:text="@string/ss_widget_hours"
                android:textColor="@color/ss_widget_muted"
                android:textSize="8sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_sep2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ss_sans"
            android:text=":"
            android:textColor="@color/ss_widget_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/w_seg3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/widget_seg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingTop="4dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/w_mins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ss_mono"
                android:includeFontPadding="false"
                android:textColor="@color/ss_widget_accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/w_minslabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ss_sans"
                android:text="@string/ss_widget_mins"
                android:textColor="@color/ss_widget_muted"
                android:textSize="8sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
</FrameLayout>
