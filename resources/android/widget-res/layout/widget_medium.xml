<?xml version="1.0" encoding="utf-8"?>
<!-- Medium (3 x 2): the app's exam countdown card with three digit tiles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/ss_sans"
        android:maxLines="1"
        android:text="@string/ss_widget_title"
        android:textColor="@color/ss_widget_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_when"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/ss_sans"
        android:maxLines="1"
        android:textColor="@color/ss_widget_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/w_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/ss_sans"
        android:maxLines="1"
        android:textColor="@color/ss_widget_warn"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/w_tm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_seg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="9dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/w_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ss_mono"
                android:includeFontPadding="false"
                android:textColor="@color/ss_widget_accent"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/w_dayslabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/ss_sans"
                android:letterSpacing="0.1"
                android:text="@string/ss_widget_days"
                android:textAllCaps="true"
                android:textColor="@color/ss_widget_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_sep1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ss_sans"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text=":"
            android:textColor="@color/ss_widget_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_seg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="9dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/w_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ss_mono"
                android:includeFontPadding="false"
                android:textColor="@color/ss_widget_accent"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/w_hourslabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/ss_sans"
                android:letterSpacing="0.1"
                android:text="@string/ss_widget_hours"
                android:textAllCaps="true"
                android:textColor="@color/ss_widget_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_sep2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ss_sans"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text=":"
            android:textColor="@color/ss_widget_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_seg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="9dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/w_mins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ss_mono"
                android:includeFontPadding="false"
                android:textColor="@color/ss_widget_accent"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/w_minslabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/ss_sans"
                android:letterSpacing="0.1"
                android:text="@string/ss_widget_mins"
                android:textAllCaps="true"
                android:textColor="@color/ss_widget_muted"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ss_sans"
        android:text="@string/ss_widget_hint"
        android:textColor="@color/ss_widget_muted"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
