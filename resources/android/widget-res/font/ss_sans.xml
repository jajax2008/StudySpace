<?xml version="1.0" encoding="utf-8"?>
<!-- The app renders text with system-ui, which is Roboto on Android. These are
     the same Roboto weights bundled so the widget never depends on the device
     font being swapped out by an OEM skin. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/ss_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/ss_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
