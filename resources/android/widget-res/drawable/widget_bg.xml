<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the app's .card: solid card colour, 1dp border, 14dp radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ss_widget_bg" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/ss_widget_border" />
</shape>
